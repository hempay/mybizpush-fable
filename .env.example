# --- Server-side (Vercel serverless function: api/consultation.js) ---
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender in Resend. The domain must be verified under
# https://resend.com/domains, otherwise delivery fails.
RESEND_FROM="MyBizPush Solutions <noreply@mybizpush.com>"

# Inbox that receives the internal notification for each inquiry
CONTACT_TO_EMAIL=info@mybizpush.com

# WhatsApp number used in the emailed chat link (digits only, international format)
WHATSAPP_PHONE=2347079084071

# --- Client-side (must be prefixed with VITE_ to reach the browser) ---
VITE_WHATSAPP_PHONE=2347079084071
